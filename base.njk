<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{% if title %}{{ title }} — {% endif %}{{ site.brand }}</title>
<meta name="description" content="{{ description or site.lead }}">
<meta property="og:title" content="{{ title or site.tagline }}">
<meta property="og:description" content="{{ description or site.lead }}">
{% if site.photo %}<meta property="og:image" content="{{ site.url }}{{ site.photo }}">{% endif %}
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🧪</text></svg>">
<link rel="preload" href="/assets/fonts/unbounded-cyrillic-600-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/site.css">
</head>
<body>
<a class="skip" href="#main">К содержанию</a>
{% set cur = page.url %}
<header class="top"><div class="wrap"><a class="logo" href="/"><i></i>{{ site.brand }}</a>
<nav class="nav" id="nav">
<a href="/level-up/"{% if cur == "/level-up/" %} aria-current="page"{% endif %}>Level Up</a>
<a href="/club/"{% if cur == "/club/" %} aria-current="page"{% endif %}>Клуб</a>
<a href="/cases/"{% if cur == "/cases/" %} aria-current="page"{% endif %}>Кейсы</a>
{% for l in landings | values | inmenu %}<a href="/l/{{ l.url }}/"{% if cur == "/l/" + l.url + "/" %} aria-current="page"{% endif %}>{{ l.tag or l.title }}</a>{% endfor %}
</nav>
<a class="btn btn-ink btn-sm" href="/level-up/">{{ course.cta }}</a>
<button class="burger" aria-label="Меню" aria-controls="nav" aria-expanded="false" data-burger>☰</button></div></header>
<main id="main">{{ content | safe }}</main>
<footer class="foot"><div class="wrap"><b>{{ site.brand }}</b><span class="muted">{{ site.place }}</span><span class="spacer"></span>
{% if site.instagram %}<a href="{{ site.instagram }}" target="_blank" rel="noopener">Instagram</a>{% endif %}
{% if site.telegram %}<a href="{{ site.telegram }}" target="_blank" rel="noopener">Telegram</a>{% endif %}
{% if site.email %}<a href="mailto:{{ site.email }}">{{ site.email }}</a>{% endif %}
<a href="/impressum/">Impressum</a><a href="/datenschutz/">Datenschutz</a></div></footer>
<div class="toast" id="toast" role="status" aria-live="polite"></div>
<script src="/assets/site.js" defer></script>
</body>
</html>
